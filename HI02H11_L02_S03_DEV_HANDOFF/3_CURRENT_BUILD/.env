# Gemini API key for the SwiftPAL asset generators (object art + Hindi voice-over).
#
# Replace the placeholder below with your real key. This file is git-ignored,
# so the key stays on your machine.
#
# ⚠ THE SCRIPTS DO NOT READ THIS FILE. They read the process environment
#   (os.environ.get("GEMINI_KEY")) and exit immediately if it is unset —
#   python-dotenv is not installed here and nothing loads .env automatically.
#   So export it into the shell before running a generator:
#
#     PowerShell   $env:GEMINI_KEY = (Get-Content .env | Select-String '^GEMINI_KEY=').ToString().Split('=')[1]
#     git-bash     export $(grep -v '^#' .env | grep -v '^$' | xargs)
#
#   Or set it directly for one run, which skips this file entirely:
#     PowerShell   $env:GEMINI_KEY = "your-key"
#     git-bash     export GEMINI_KEY="your-key"
#
# Both names are set because the tooling accepts either: the generators read
# GEMINI_KEY, while verify_bundle.py and aap_register_standard.py fall back to
# GEMINI_API_KEY. Keep them identical.

GEMINI_KEY=AIzaSyADOun8vbpwh4nIF1ZOYpA-qGMzSV_-KXw
GEMINI_API_KEY=AIzaSyADOun8vbpwh4nIF1ZOYpA-qGMzSV_-KXw
