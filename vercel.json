{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/.env", "destination": "/", "permanent": false },
    { "source": "/:path*/.env", "destination": "/", "permanent": false },
    { "source": "/:path*/.env.:ext", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/HI02H11_L02_S03_DEV_HANDOFF/3_CURRENT_BUILD/HI02H11_L02_S03.html" },
    { "source": "/index.html", "destination": "/HI02H11_L02_S03_DEV_HANDOFF/3_CURRENT_BUILD/HI02H11_L02_S03.html" },
    { "source": "/HI02H11_L02_S03.html", "destination": "/HI02H11_L02_S03_DEV_HANDOFF/3_CURRENT_BUILD/HI02H11_L02_S03.html" },
    { "source": "/card.json", "destination": "/HI02H11_L02_S03_DEV_HANDOFF/3_CURRENT_BUILD/card.json" },
    { "source": "/favicon.ico", "destination": "/HI02H11_L02_S03_DEV_HANDOFF/3_CURRENT_BUILD/assets/UI/favicon.ico" },
    { "source": "/assets/:path*", "destination": "/HI02H11_L02_S03_DEV_HANDOFF/3_CURRENT_BUILD/assets/:path*" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/card.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/Audio/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/MatraRunner/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
